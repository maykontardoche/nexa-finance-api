# Modelo de configuração local. Copie para .env (nunca versionado) e ajuste os valores.
# Todos os valores abaixo são fictícios. O .env é lido pelo Docker Compose e pela aplicação
# no perfil local (spring.config.import em application-local.yml), então os dois usam a mesma
# configuração. Os testes automatizados não leem este arquivo.

# As três variáveis DB_* são o contrato do projeto: a aplicação recusa subir sem elas, mesmo que
# SPRING_DATASOURCE_* esteja definido.

# URL JDBC do PostgreSQL. Obrigatória. Com o Compose, o banco no fim da URL é o DB_NAME.
# Não coloque usuário nem senha na URL: ela aparece no log de startup do Flyway.
DB_URL=jdbc:postgresql://localhost:5432/nexa
# Usuário do banco. Obrigatória. O Compose cria esse usuário como dono do DB_NAME.
DB_USERNAME=nexa
# Senha do banco. Obrigatória. Troque por uma senha só sua.
DB_PASSWORD=troque-me
# Nome do banco criado pelo serviço db do Compose. Usada só pelo Compose.
DB_NAME=nexa
# Porta HTTP da aplicação. Opcional (padrão 8080). No Compose, é a porta publicada no host.
SERVER_PORT=8080

# Endereço base dos links enviados por e-mail (confirmação de cadastro, troca de e-mail).
# Obrigatória. Use o endereço em que você acessa a API; se mudar SERVER_PORT, mude aqui também.
APP_BASE_URL=http://localhost:8080
# Servidor SMTP. Opcionais: o padrão (localhost:1025) é a caixa de e-mail local do Compose
# (serviço mail, aberta em http://localhost:8025). No Compose, a aplicação usa o serviço mail
# e ignora estes dois valores.
MAIL_HOST=localhost
MAIL_PORT=1025
# Remetente dos e-mails. Opcional (padrão: Nexa Finance <nao-responda@nexa-finance.local>).
MAIL_FROM=Nexa Finance <nao-responda@nexa-finance.local>
